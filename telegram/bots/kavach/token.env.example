# KAVACH Telegram identity — used by Kavach 2.0 (Phase-1)
# SAFE TO COMMIT — no real secrets here
#
# Classic KAVACH bot (@kavach_batmanbot) is the only Kavach Telegram bot.
# Kavach 2.0 loads these keys via get_bot_credentials("kavach2").
#
# Copy to token.env (gitignored) and fill real values:
#   cp token.env.example token.env

KAVACH_BOT_TOKEN=your_kavach_bot_token_here
KAVACH_CHAT_ID=your_chat_id_here
