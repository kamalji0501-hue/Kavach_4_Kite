# DRISHTI Bot — Token File
# ─────────────────────────────────────────────────────────────────────────────
# DRISHTI (दृष्टि) = Infrastructure Health + Access Token Management
#
# HOW TO UPDATE YOUR TOKEN:
#   1. Open this file
#   2. Replace the value of DRISHTI_BOT_TOKEN with the new token
#   3. Save — the system will hot-reload automatically (no restart needed)
#
# WHERE TO GET YOUR TOKEN:
#   - Open Telegram → search @BotFather → /newbot or /token
#
# WHERE TO GET YOUR CHAT ID:
#   - Send any message to your bot → open in browser:
#     https://api.telegram.org/bot<your_token>/getUpdates
#   - Look for "chat" → "id" in the response
#
# ─────────────────────────────────────────────────────────────────────────────
# !! DO NOT commit this file to git — it contains your real API token !!
# ─────────────────────────────────────────────────────────────────────────────

DRISHTI_BOT_TOKEN=your_drishti_bot_token_here
DRISHTI_CHAT_ID=your_chat_id_here
